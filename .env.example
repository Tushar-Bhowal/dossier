GEMINI_API_KEY=
# Requests/tokens per minute the shared rate limiter enforces in front of every Gemini call.
# Free-tier limits vary by model and change over time — set these to match your key's tier.
LLM_RPM=15
LLM_TPM=1000000

# Optional — unset falls through silently to the keyless DuckDuckGo/Reddit search fallback.
TAVILY_API_KEY=
