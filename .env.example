GEMINI_API_KEY=
# Requests/tokens per minute the shared rate limiter enforces in front of every Gemini call.
# Free-tier limits vary by model and change over time — set these to match your key's tier.
LLM_RPM=15
LLM_TPM=1000000

# Optional — unset falls through silently to the keyless DuckDuckGo/Reddit search fallback.
TAVILY_API_KEY=

# MongoDB Atlas M0 connection string. Needs 0.0.0.0/0 network access for serverless functions.
MONGODB_URI=
MONGODB_DB=dossier

# Secret used to sign session JWTs — any long random string. Rotating it invalidates every
# existing session.
JWT_SECRET=

# CLI-only escape hatch for §11's private/loopback-address rejection, so the batch command can
# crawl a company site served from localhost. Never set this in a deployed environment — the API
# never reads it.
ALLOW_PRIVATE_HOSTS=
